# DevPilot environment variables (placeholders only - never commit real values)
# Gemini API key used by `devpilot explain`, `devpilot plan` and AI fixes.
GEMINI_API_KEY=
# Optional alias accepted by Google AI SDKs / tools:
GOOGLE_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
DEVPILOT_GEMINI_MODEL=
# Optional: disable all AI features (1/true)
DEVPILOT_AI_DISABLED=

