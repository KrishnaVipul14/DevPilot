# DevPilot environment variables (placeholders only - never commit real values)

# Groq API key used by `devpilot explain`, `devpilot plan` and AI fixes
GROQ_API_KEY=
# Optional: override the Groq model
DEVPILOT_GROQ_MODEL=

# Google Gemini API key
GEMINI_API_KEY=
# Alternative Gemini API key name
GOOGLE_API_KEY=
# Optional: override the Gemini model
DEVPILOT_GEMINI_MODEL=

# AI provider selection: 'groq' or 'gemini' (auto-detected if unset)
DEVPILOT_AI_PROVIDER=
# Optional: global model override across providers
DEVPILOT_AI_MODEL=
# Optional: disable all AI features (1/true)
DEVPILOT_AI_DISABLED=

